<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      Log file location. Resolution order:
        1. logging.file.name from the Spring properties file
        2. LOG_FILE environment variable
        3. platform default (Linux/macOS: /tmp, Windows: C:\temp)
      Never log to console: stdout is reserved for the MCP stdio transport.
    -->
    <springProperty scope="context" name="logFileName" source="logging.file.name"/>
    <property name="LOG_PATH" value="${logFileName:-${LOG_FILE:-/tmp/db2-luw-client-mcp.log}}"/>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE" />
    </root>

    <logger name="com.example" level="DEBUG"/>
</configuration>
